{
  "name": "orc-review",
  "version": "0.2.2",
  "license": "0BSD",
  "type": "module",
  "description": "Model-planned code review workflows on the orc runtime: creation, running, and monitoring of the review workflow \u2014 nothing past it.",
  "main": "dist/index.js",
  "bin": {
    "orc-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "prepack": "npm run build",
    "release": "node scripts/publish-if-new.mjs"
  },
  "dependencies": {
    "@karowanorg/orc-core": "^0.1.2",
    "@karowanorg/orc-executors": "^0.1.1",
    "@karowanorg/orc-harness-claude": "^0.1.3",
    "@karowanorg/orc-harness-codex": "^0.1.3",
    "@karowanorg/orc-ops": "^0.1.2",
    "@karowanorg/orc-sdk": "^0.1.2",
    "@karowanorg/orc-ui": "^0.1.1",
    "commander": "^13.0.0",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karowan/orc-review.git"
  },
  "engines": {
    "node": ">=20"
  }
}
