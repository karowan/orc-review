{
  "name": "orc-review",
  "version": "0.1.3",
  "license": "0BSD",
  "type": "module",
  "description": "Model-planned code review workflows on the orc runtime: creation, running, and monitoring of the review workflow \u2014 nothing past it.",
  "main": "dist/index.js",
  "bin": {
    "orc-review": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "prepack": "npm run build && node scripts/publish-deps.mjs swap",
    "postpack": "node scripts/publish-deps.mjs restore"
  },
  "dependencies": {
    "@karowanorg/orc-core": "file:../orc/packages/core",
    "@karowanorg/orc-executors": "file:../orc/packages/executors",
    "@karowanorg/orc-harness-claude": "file:../orc/packages/harness-claude",
    "@karowanorg/orc-harness-codex": "file:../orc/packages/harness-codex",
    "@karowanorg/orc-ops": "file:../orc/packages/ops",
    "@karowanorg/orc-sdk": "file:../orc/packages/sdk",
    "@karowanorg/orc-ui": "file:../orc/packages/ui",
    "commander": "^13.0.0",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
